# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@yourdomain.com

# Optional: a shared secret so only your conversion tool can call
# /api/admin/register-app (prevents randoms from registering apps)
ADMIN_API_KEY=change-this-to-something-random
